					<TR><TD ALIGN="LEFT">releasecount_artist</TD></TR>
					<TR><TD ALIGN="LEFT">releasecount</TD></TR>
					<TR><TD ALIGN="LEFT">release_collaboration</TD></TR>
				</TABLE>
			>
		];

		join_kn1arelease [
			shape=point,
			width=0.15,
			color="#005eff"
		];

		join_kn1arelease -> kn1arelease:n;

		join_kn12release [
			shape=point,
			width=0.15,
			color="#005eff"
		];

		kn1arelease:n -> join_kn12release [arrowhead=none];
		kn1brelease:x -> join_kn12release [arrowhead=none];
		join_kn12release -> kn12release:y;

		join_xn13release [
			shape=point,
			width=0.15,
			color="#005eff"
		];

		kn12release:n -> join_xn13release [arrowhead=none];
		join_xn13release -> xn13release:n;

	}


	/* ── non-clustered relations ─────────────────────────────────────── */
	artist:n -> xz11artist:n;
	master_artist:x -> kz11master:x;
	xz11artist:n -> join_xz11master [arrowhead=none];

	release:n -> kz1arelease:x;
	release_artist:y -> kz1brelease:x;

	release:n -> join_kn1arelease [arrowhead=none];
	release_no_master:x -> join_kn1arelease [arrowhead=none];

	release_artist:y -> kn1brelease:x;
	xz11artist:n -> join_xn13release [arrowhead=none];

	join_xzn13release [
		shape=point,
		width=0.15,
		color="#005eff"
	];

	xz13release:x -> join_xzn13release [arrowhead=none];
	xn13release:x -> join_xzn13release [arrowhead=none];
	join_xzn13release -> xzn13release:x;

	join_label_format [
		shape=point,
		width=0.15,
		color="#005eff"
	];

	release_label:y -> join_label_format [arrowhead=none];
	release_format:y -> join_label_format [arrowhead=none];

	join_xzn24format [
		shape=point,
		width=0.15,
		color="#005eff"
	];

	xzn13release:y -> join_xzn24format [arrowhead=none];
	join_label_format -> join_xzn24format;
	join_xzn24format -> xzn24format:y;

	join_xzn24tracklist [
		shape=point,
		width=0.15,
		color="#005eff"
	];

	xzn13release:y -> join_xzn24tracklist [arrowhead=none];
	release_track:y -> join_xzn24tracklist [arrowhead=none];
	join_xzn24tracklist -> xzn24tracklist:y;

}
