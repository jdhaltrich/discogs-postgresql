digraph discogs_db {
	graph [
		label="discogs db model architecture",
		fontname="source code pro",
		fontsize=60,
		labelloc=t,
		rankdir=LR,
//		bgcolor="#9e9cff:#27ddf5",     /* lila a celeste */
		bgcolor="#9187ff:#f527d6",
//		bgcolor="#000000:#f527d6",     /* negro a fucsia */
		gradientangle=57,
		splines=true,
		overlap=false
	];

	node [
		fontname="source code pro",
		fontsize=12,
		fontcolor="#000000"
	];

	edge [
		fontname="source code pro",
		fontsize=6,
		color="#005eff",
		penwidth=2
	];

	/* ── base tables (grey) ─────────────────────────────────────── */
	subgraph tables {
		node [
			shape=none
		];

		artist [
			label=<
				<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#d1d1d1">
					<TR><TD ALIGN="LEFT"><B>artist</B></TD></TR>
					<TR><TD PORT="n" ALIGN="LEFT">id</TD></TR>
					<TR><TD ALIGN="LEFT">name</TD></TR>
					<TR><TD ALIGN="LEFT">realname</TD></TR>
					<TR><TD ALIGN="LEFT">profile</TD></TR>
					<TR><TD ALIGN="LEFT">data_quality</TD></TR>
				</TABLE>
			>
		];

		artist_alias [
			label=<
				<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#d1d1d1">
					<TR><TD ALIGN="LEFT"><B>artist_alias</B></TD></TR>
					<TR><TD PORT="n" ALIGN="LEFT">artist_id</TD></TR>
					<TR><TD ALIGN="LEFT">alias_name</TD></TR>
					<TR><TD ALIGN="LEFT">alias_artist_id</TD></TR>
				</TABLE>
			>
		];

		master_artist [
			label=<
				<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#d1d1d1">
					<TR><TD ALIGN="LEFT"><B>master_artist</B></TD></TR>
					<TR><TD ALIGN="LEFT">id</TD></TR>
					<TR><TD PORT="x" ALIGN="LEFT">master_id</TD></TR>
					<TR><TD PORT="n" ALIGN="LEFT">artist_id</TD></TR>
					<TR><TD ALIGN="LEFT">artist_name</TD></TR>
					<TR><TD ALIGN="LEFT">anv</TD></TR>
					<TR><TD ALIGN="LEFT">position</TD></TR>
					<TR><TD ALIGN="LEFT">join_string</TD></TR>
					<TR><TD ALIGN="LEFT">role</TD></TR>
				</TABLE>
			>
		];

		master [
			label=<
				<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#d1d1d1">
					<TR><TD ALIGN="LEFT"><B>master</B></TD></TR>
					<TR><TD PORT="n" ALIGN="LEFT">id</TD></TR>
					<TR><TD ALIGN="LEFT">title</TD></TR>
					<TR><TD ALIGN="LEFT">year</TD></TR>
					<TR><TD ALIGN="LEFT">main_release</TD></TR>
					<TR><TD ALIGN="LEFT">data_quality</TD></TR>
				</TABLE>
			>
		];

		release [
			label=<
				<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#d1d1d1">
					<TR><TD ALIGN="LEFT"><B>release</B></TD></TR>
					<TR><TD PORT="n" ALIGN="LEFT">id</TD></TR>
					<TR><TD ALIGN="LEFT">title</TD></TR>
					<TR><TD ALIGN="LEFT">released</TD></TR>
					<TR><TD ALIGN="LEFT">country</TD></TR>
					<TR><TD ALIGN="LEFT">notes</TD></TR>
					<TR><TD ALIGN="LEFT">data_quality</TD></TR>
					<TR><TD ALIGN="LEFT">main</TD></TR>
					<TR><TD PORT="x" ALIGN="LEFT">master_id</TD></TR>
					<TR><TD ALIGN="LEFT">status</TD></TR>
				</TABLE>
			>
		];

		release_artist [
			label=<
				<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#d1d1d1">
					<TR><TD ALIGN="LEFT"><B>release_artist</B></TD></TR>
					<TR><TD ALIGN="LEFT">id</TD></TR>
					<TR><TD PORT="y" ALIGN="LEFT">release_id</TD></TR>
					<TR><TD PORT="n" ALIGN="LEFT">artist_id</TD></TR>
					<TR><TD ALIGN="LEFT">artist_name</TD></TR>
					<TR><TD ALIGN="LEFT">extra</TD></TR>
					<TR><TD ALIGN="LEFT">anv</TD></TR>
					<TR><TD ALIGN="LEFT">position</TD></TR>
					<TR><TD ALIGN="LEFT">join_string</TD></TR>
					<TR><TD ALIGN="LEFT">role</TD></TR>
					<TR><TD ALIGN="LEFT">tracks</TD></TR>
				</TABLE>
			>
		];

		release_label [
			label=<
				<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#d1d1d1">
					<TR><TD ALIGN="LEFT"><B>release_label</B></TD></TR>
					<TR><TD ALIGN="LEFT">id</TD></TR>
					<TR><TD PORT="y" ALIGN="LEFT">release_id</TD></TR>
					<TR><TD ALIGN="LEFT">label_id</TD></TR>
					<TR><TD ALIGN="LEFT">label_name</TD></TR>
					<TR><TD ALIGN="LEFT">catno</TD></TR>
				</TABLE>
			>
		];

		release_format [
			label=<
				<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#d1d1d1">
					<TR><TD ALIGN="LEFT"><B>release_format</B></TD></TR>
					<TR><TD ALIGN="LEFT">id</TD></TR>
					<TR><TD PORT="y" ALIGN="LEFT">release_id</TD></TR>
					<TR><TD ALIGN="LEFT">name</TD></TR>
					<TR><TD ALIGN="LEFT">qty</TD></TR>
					<TR><TD ALIGN="LEFT">text_string</TD></TR>
					<TR><TD ALIGN="LEFT">descriptions</TD></TR>
				</TABLE>
			>
		];

		release_track [
			label=<
				<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#d1d1d1">
					<TR><TD ALIGN="LEFT"><B>release_track</B></TD></TR>
					<TR><TD ALIGN="LEFT">id</TD></TR>
					<TR><TD PORT="y" ALIGN="LEFT">release_id</TD></TR>
					<TR><TD ALIGN="LEFT">sequence</TD></TR>
					<TR><TD ALIGN="LEFT">position</TD></TR>
					<TR><TD ALIGN="LEFT">parent</TD></TR>
					<TR><TD ALIGN="LEFT">title</TD></TR>
					<TR><TD ALIGN="LEFT">duration</TD></TR>
					<TR><TD ALIGN="LEFT">track_id</TD></TR>
				</TABLE>
			>
		];

		release_no_master [
			label=<
				<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#d1d1d1">
					<TR><TD ALIGN="LEFT"><B>release_no_master</B></TD></TR>
					<TR><TD ALIGN="LEFT">unique_id</TD></TR>
					<TR><TD PORT="n" ALIGN="LEFT">artist_id</TD></TR>
					<TR><TD PORT="x" ALIGN="LEFT">release_id</TD></TR>
				</TABLE>
			>
		];

	}

	/* ── non-clustered functions ─────────────────────────────────────── */
	subgraph functions {
		node [
			shape=none
		];

		xz11artist [
			label=<
				<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#27f5b7">
					<TR><TD ALIGN="LEFT" BGCOLOR="#27f5b7"><B>xz11artist</B></TD></TR>
					<TR><TD PORT="n" ALIGN="LEFT">artist_id</TD></TR>
					<TR><TD ALIGN="LEFT">artist_name</TD></TR>
					<TR><TD ALIGN="LEFT">artist_realname</TD></TR>
					<TR><TD ALIGN="LEFT">data_quality</TD></TR>
				</TABLE>
			>
		];

		xzn13release [
			label=<
				<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#27f5b7">
					<TR><TD ALIGN="LEFT" BGCOLOR="#27f5b7"><B>xzn13release (union xz13/xn13)</B></TD></TR>
					<TR><TD PORT="n" ALIGN="LEFT">artist_id</TD></TR>
					<TR><TD ALIGN="LEFT">artist_name</TD></TR>
					<TR><TD PORT="x" ALIGN="LEFT">master_id</TD></TR>
					<TR><TD ALIGN="LEFT">mastercount_artist</TD></TR>
					<TR><TD ALIGN="LEFT">mastercount</TD></TR>
					<TR><TD ALIGN="LEFT">master_collaboration</TD></TR>
					<TR><TD ALIGN="LEFT">master_year</TD></TR>
					<TR><TD ALIGN="LEFT">master_title</TD></TR>
					<TR><TD ALIGN="LEFT">master_data_quality</TD></TR>
					<TR><TD PORT="y" ALIGN="LEFT">release_id</TD></TR>
					<TR><TD ALIGN="LEFT">release_date</TD></TR>
					<TR><TD ALIGN="LEFT">release_title</TD></TR>
					<TR><TD ALIGN="LEFT">release_country</TD></TR>
					<TR><TD ALIGN="LEFT">release_data_quality</TD></TR>
					<TR><TD ALIGN="LEFT">releasecount_artist</TD></TR>
					<TR><TD ALIGN="LEFT">releasecount</TD></TR>
					<TR><TD ALIGN="LEFT">release_collaboration</TD></TR>
				</TABLE>
			>
		];

		xzn24format [
			label=<
				<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#27f5b7">
