					<TR><TD PORT="n" ALIGN="LEFT">artist_id</TD></TR>
					<TR><TD ALIGN="LEFT">artist_name</TD></TR>
					<TR><TD PORT="x" ALIGN="LEFT">master_id</TD></TR>
					<TR><TD ALIGN="LEFT">mastercount_artist</TD></TR>
					<TR><TD ALIGN="LEFT">mastercount</TD></TR>
					<TR><TD ALIGN="LEFT">master_collaboration</TD></TR>
					<TR><TD ALIGN="LEFT">master_year</TD></TR>
					<TR><TD ALIGN="LEFT">master_title</TD></TR>
					<TR><TD ALIGN="LEFT">master_data_quality</TD></TR>
				</TABLE>
			>
		];

		kz1arelease [
			label=<
				<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#ffff75">
					<TR><TD ALIGN="LEFT" BGCOLOR="#ffff75"><B>kz1arelease</B></TD></TR>
					<TR><TD PORT="n" ALIGN="LEFT">master_id</TD></TR>
					<TR><TD PORT="x" ALIGN="LEFT">release_id</TD></TR>
					<TR><TD ALIGN="LEFT">release_title</TD></TR>
					<TR><TD ALIGN="LEFT">release_date</TD></TR>
					<TR><TD ALIGN="LEFT">release_country</TD></TR>
					<TR><TD ALIGN="LEFT">release_data_quality</TD></TR>
				</TABLE>
			>
		];

		kz1brelease [
			label=<
				<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#ffff75">
					<TR><TD ALIGN="LEFT" BGCOLOR="#ffff75"><B>kz1brelease</B></TD></TR>
					<TR><TD PORT="n" ALIGN="LEFT">artist_id</TD></TR>
					<TR><TD PORT="x" ALIGN="LEFT">release_id</TD></TR>
					<TR><TD ALIGN="LEFT">releasecount_artist</TD></TR>
					<TR><TD ALIGN="LEFT">releasecount</TD></TR>
				</TABLE>
			>
		];

		kz12release [
			label=<
				<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#ffff75">
					<TR><TD ALIGN="LEFT" BGCOLOR="#ffff75"><B>kz12release</B></TD></TR>
					<TR><TD PORT="n" ALIGN="LEFT">artist_id</TD></TR>
					<TR><TD PORT="x" ALIGN="LEFT">master_id</TD></TR>
					<TR><TD PORT="y" ALIGN="LEFT">release_id</TD></TR>
					<TR><TD ALIGN="LEFT">release_title</TD></TR>
					<TR><TD ALIGN="LEFT">release_date</TD></TR>
					<TR><TD ALIGN="LEFT">release_country</TD></TR>
					<TR><TD ALIGN="LEFT">release_data_quality</TD></TR>
					<TR><TD ALIGN="LEFT">releasecount_artist</TD></TR>
					<TR><TD ALIGN="LEFT">releasecount</TD></TR>
				</TABLE>
			>
		];

		xz13release [
			label=<
				<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#27f5b7">
					<TR><TD ALIGN="LEFT" BGCOLOR="#27f5b7"><B>xz13release</B></TD></TR>
					<TR><TD PORT="n" ALIGN="LEFT">artist_id</TD></TR>
					<TR><TD ALIGN="LEFT">artist_name</TD></TR>
					<TR><TD PORT="x" ALIGN="LEFT">master_id</TD></TR>
					<TR><TD ALIGN="LEFT">mastercount_artist</TD></TR>
					<TR><TD ALIGN="LEFT">mastercount</TD></TR>
					<TR><TD ALIGN="LEFT">master_collaboration</TD></TR>
					<TR><TD ALIGN="LEFT">master_year</TD></TR>
					<TR><TD ALIGN="LEFT">master_title</TD></TR>
					<TR><TD ALIGN="LEFT">master_data_quality</TD></TR>
					<TR><TD PORT="y" ALIGN="LEFT">release_id</TD></TR>
					<TR><TD ALIGN="LEFT">release_date</TD></TR>
					<TR><TD ALIGN="LEFT">release_title</TD></TR>
					<TR><TD ALIGN="LEFT">release_country</TD></TR>
					<TR><TD ALIGN="LEFT">release_data_quality</TD></TR>
					<TR><TD ALIGN="LEFT">releasecount_artist</TD></TR>
					<TR><TD ALIGN="LEFT">releasecount</TD></TR>
					<TR><TD ALIGN="LEFT">release_collaboration</TD></TR>
				</TABLE>
			>
		];

		join_xz11master [
			shape=point,
			width=0.15,
			color="#005eff"
		];

		kz11master:n -> join_xz11master [arrowhead=none];
		join_xz11master -> xz11master:n;

		join_xz12master [
			shape=point,
			width=0.15,
			color="#005eff"
		];

		xz11master:x -> join_xz12master [arrowhead=none];
		master:n -> join_xz12master [arrowhead=none];
		join_xz12master -> xz12master:x;

		join_kz12release [
			shape=point,
			width=0.15,
			color="#005eff"
		];

		kz1arelease:x -> join_kz12release [arrowhead=none];
		kz1brelease:x -> join_kz12release [arrowhead=none];
		join_kz12release -> kz12release:y;

		join_xz13release [
			shape=point,
			width=0.15,
			color="#005eff"
		];

		xz12master:x -> join_xz13release [arrowhead=none];
		kz12release:x -> join_xz13release [arrowhead=none];
		join_xz13release -> xz13release:x;

	}

