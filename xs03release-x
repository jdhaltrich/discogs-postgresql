psql \
	-U postgres \
	-d discogs \
	-c \
	'
	create or replace function xs03release_x(
		artistid integer
	)
	returns table(
		artist_id integer,
		artist_name text,
		master_id integer,
		master_title text,
		master_year integer,
		master_data_quality text,
		release_id integer,
		release_title text,
		release_date text,
		release_country text,
		release_data_quality text
	)
	as $$
	begin
	return query
		select
			n.artist_id,
			n.artist_name,
			n.master_id,
			n.master_title,
			n.master_year,
			n.master_data_quality,
			n.release_id,
			n.release_title,
			n.release_date,
			n.release_country,
			n.release_data_quality
		from
			xz03release_x(
				artistid
			) n
		order by
			n.master_year,
			n.master_id,
			n.release_date,
			n.release_id
		;
	end;
	$$ language plpgsql;
	'
